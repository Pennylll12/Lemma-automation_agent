# Copy this file to .env, fill locally, and NEVER commit .env.
ADMIN_TOKEN=replace-with-a-long-random-token
WEBHOOK_SECRET=replace-with-another-long-random-token
DATABASE_PATH=data/flow.db
TEST_PHONE_ALLOWLIST=85290000001
EMBEDDED_WORKER=false
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
# Set to a model supported by your current DeepSeek account.
DEEPSEEK_MODEL=deepseek-flash
LIVE_SEND_ENABLED=false
# Needed only if opening the hosted workbench against a different backend domain.
CORS_ORIGINS=
# Do not guess these: copy from verified current SleekFlow Send Message docs.
SLEEKFLOW_SEND_URL=
SLEEKFLOW_AUTH_HEADER=
SLEEKFLOW_AUTH_VALUE=
# Valid JSON. Supported placeholders: {{recipient}}, {{channel}}, {{reply}}.
# Example must be replaced with the verified SleekFlow body schema before live use.
SLEEKFLOW_BODY_TEMPLATE=

# Optional callback into a SECOND SleekFlow "Webhook payload received" flow.
# Enabling this can trigger WhatsApp messages even with LIVE_SEND_ENABLED=false.
# Keep the direct API route OFF when using the callback route (mutually exclusive).
SLEEKFLOW_REPLY_WEBHOOK_ENABLED=false
SLEEKFLOW_REPLY_WEBHOOK_URL=
# JSON object of exact header names/values copied from SleekFlow's generated POST example.
# Use shell single quotes around the JSON when filling .env. Never commit the token/URL.
SLEEKFLOW_REPLY_WEBHOOK_HEADERS='{}'

# Calendar integration: mock preserves the original demo; google enables read-only lookup.
CALENDAR_MODE=mock
GOOGLE_CALENDAR_ID=lemma@supermama.homes
# Recommended: upload the official JSON into the ignored secrets/ directory.
# Use this relative path from the repository root. Never paste its content in chat.
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-calendar.json
# Alternative Codespaces Secret: GOOGLE_SERVICE_ACCOUNT_JSON (full JSON, not both).
# Optional confirmed travel buffer in minutes; blank means still needs manual review.
CALENDAR_TRAVEL_MINUTES=
# Optional TWO daily breaks, each 30-50 minutes; blank means meals need review.
# Example format only, NOT an approved schedule: '12:00-12:30,19:00-19:40'
CALENDAR_MEAL_BREAKS=
# Confirmed business days: Monday-Saturday excluding HK public holidays.
CALENDAR_BUSINESS_WEEK=mon_sat

# Admin execution reports: stored even when email is disabled.
# Leave blank for DATABASE_PATH's parent directory + /audit.
AUDIT_LOG_DIR=
AUDIT_EMAIL_ENABLED=false
# Fill locally. One address each; do not put real customer addresses in Git.
ADMIN_EMAIL_TO=
SMTP_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
# Google app password if allowed by your Workspace policy; not your normal password.
SMTP_PASSWORD=
